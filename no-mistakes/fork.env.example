# Copy to ~/.agent-config/no-mistakes-fork.env and fill in your GitHub username.
# setup.sh sources this file when present.

# Personal fork of https://github.com/kunchenguid/no-mistakes
NO_MISTAKES_FORK=https://github.com/YOUR_GITHUB_USER/no-mistakes.git
NO_MISTAKES_FORK_BRANCH=main

# Where the fork is cloned and built on this machine
NO_MISTAKES_SRC=$HOME/src/no-mistakes
